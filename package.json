{
 "name": "icu-next",
 "version": "0.1.0",
 "private": true,
 "scripts": {
  "dev": "next dev",
  "build": "next build",
  "build:api": "bun build server/index.ts --target=bun --outdir=dist",
  "build:all": "npm run build && npm run build:api",
  "start": "next start",
  "lint": "next lint",
  "typecheck": "next typegen && tsc --noEmit",
  "api": "bun --watch server/index.ts",
  "dev:all": "concurrently \"npm run dev\" \"npm run api\""
 },
 "dependencies": {
  "@elysia/jwt": "^1.4.2",
  "@elysia/openapi": "^1.4.15",
  "@elysiajs/cors": "^1.4.2",
  "@elysiajs/swagger": "^1.3.1",
  "@emotion/react": "^11.14.0",
  "@emotion/styled": "^11.14.1",
  "@mui/icons-material": "^5.16.7",
  "@mui/material": "^9.3.1",
  "@mui/material-nextjs": "^5.16.7",
  "@mui/x-date-pickers": "^9.11.0",
  "@sinclair/typebox": "^0.34.52",
  "axios": "^1.19.0",
  "dayjs": "^1.11.21",
  "elysia": "^1.1.23",
  "mongoose": "^7.8.11",
  "next": "^15.0.0",
  "next-intl": "^4.13.4",
  "notistack": "^3.0.2",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "react-hook-form-mui": "^9.0.1",
  "sharp": "^0.35.0",
  "swr": "^2.2.5"
 },
 "devDependencies": {
  "@types/bun": "^1.3.14",
  "@types/node": "^20.17.10",
  "@types/react": "^18.3.12",
  "@types/react-dom": "^18.3.1",
  "concurrently": "^9.0.0",
  "eslint": "^8.57.1",
  "eslint-config-next": "^15.0.0",
  "typescript": "^5.7.2"
 },
 "overrides": {
  "sharp": "^0.35.0"
 }
}
